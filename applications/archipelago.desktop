#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Archipelago
Exec=${HOME}/bin/archipelago-wait-rom.sh "%f"
TryExec=${HOME}/AppImages/archipelago.appimage
Icon=${HOME}/AppImages/.icons/archipelago
Terminal=false
NoDisplay=false
StartupNotify=true
Categories=Game;
MimeType=application/x-apladx;application/x-apfirered;application/x-apsnap;application/x-apcrystal;
X-AppImage-Name=Archipelago
